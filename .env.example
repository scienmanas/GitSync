# Comments go on their own line: `docker run --env-file` does not strip a
# trailing "# ..." and would read it as part of the value.

# --- GitHub. Always needed: every command starts by reading your repos. ---
GITHUB_USER=your-github-username
# Needs repo read access
GITHUB_TOKEN=your-github-token
# Optional. Back up your forks too (default true). false skips every fork -
# handy when they are just copies of other people's (possibly huge) projects.
# INCLUDE_FORKS=true

# --- GitLab. Only needed for 'sync' (pushing there); 'archive' ignores it. ---
GITLAB_USER=your-gitlab-username
# Needs the api and write_repository scopes
GITLAB_TOKEN=your-gitlab-token
# Optional. Push into this group instead of your own namespace.
# GITLAB_GROUP=your-gitlab-group
# Optional. 'auto' matches each repo's GitHub visibility; 'public' or 'private' forces one for all.
REPO_VISIBILITY=auto
# Optional. GitLab refuses force pushes to protected branches (every project's
# main branch), so a repo whose history was rewritten on GitHub can't be mirrored.
# true lets GitSync turn on "allowed to force push" for that project's protected
# branches when a push is refused for that reason, and retry. Default false.
# GITLAB_ALLOW_FORCE_PUSH=true

# --- Speed. Optional. ---
# Share of the CPU cores to keep busy, 1-100. Decides how many repos are handled in parallel.
CPU_LOAD_PERCENT=70
# Pin the number of repos handled in parallel. 0 means derive it from CPU_LOAD_PERCENT.
MAX_WORKERS=0

# --- Where things go. Optional - and leave them commented out for Docker, ---
# --- whose defaults put everything in the /data volume. ---
# Local mirrors. Default: ./repos-backup
# BACKUP_DIR=./repos-backup
# Zip files from 'archive'. Default: ./archives
# ARCHIVE_DIR=./archives
# Timestamped log files. Default: ./Logs next to the project
# LOGS_DIR=
# Days to keep log files - every run writes its own. Default 30; 0 keeps them all.
# LOG_RETENTION_DAYS=30

# --- Archive. Optional. ---
# Folder names stripped from 'archive --mode code' snapshots. Unset uses the
# built-in list below; uncomment and edit it (e.g. drop 'dist') to change it.
# CODE_ARCHIVE_EXCLUDE_DIRS=node_modules,bower_components,jspm_packages,vendor,Pods,.venv,venv,env,virtualenv,site-packages,__pypackages__,__pycache__,.mypy_cache,.pytest_cache,.ruff_cache,.tox,.gradle,.terraform,.next,.nuxt,.cache,.parcel-cache,dist,build,target,out,coverage

# --- Docker only. Ignored when you run main.py yourself. ---
# The container reads every setting above from the environment too, so this same
# file works as `docker run --env-file .env` or docker compose's env_file.
# Set it and the container stays up, running CRON_COMMAND on this schedule. Empty means run once and exit.
# At most hourly: anything more frequent (e.g. */15 * * * *) is refused at startup.
CRON_SCHEDULE=0 2 * * *
# What each scheduled run does: 'sync' (GitHub -> GitLab) or e.g. 'archive --mode code' (GitHub -> zip).
CRON_COMMAND=sync
# Run as soon as the container starts, instead of waiting for the first slot.
RUN_ON_START=true
# The timezone CRON_SCHEDULE is read in.
TZ=UTC
